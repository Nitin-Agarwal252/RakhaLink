{
  "expo": {
    "name": "RakshaLink",
    "slug": "rakshalink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      ["expo-sensors", { "motionPermission": "RakshaLink uses device motion while crash monitoring is enabled." }],
      ["expo-location", { "locationWhenInUsePermission": "RakshaLink uses foreground location speed while crash monitoring is enabled." }]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
